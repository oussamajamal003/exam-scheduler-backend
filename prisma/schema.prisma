generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  PROCTOR
  STUDENT
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
}

enum OfferingStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

enum CourseType {
  COURSE
  PROJECT
}

enum SchedulingAlgorithmType {
  HYBRID_CONSTRAINT_BASED
}

enum ScheduleGenerationStage {
  PREPARED
  VALIDATED
  DRAFT_BUILT
  EVALUATED
  OPTIMIZED
  RE_EVALUATED
  CONFIRMED
  GENERATED
  BLOCKED
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  password      String
  role          Role           @default(STUDENT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]
  proctor       Proctor?
  student       Student?
  settings      UserSettings?

  @@map("users")
}

model UserSettings {
  id                             String   @id @default(uuid())
  userId                         String   @unique
  schedulePublishedNotifications Boolean  @default(true)
  examAssignmentUpdates          Boolean  @default(true)
  roomTimeChanges                Boolean  @default(true)
  announcementsMessages          Boolean  @default(true)
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt
  user                           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Student {
  id            String                @id @default(uuid())
  userId        String                @unique
  programId     String?
  universityId  String                @unique
  createdBy     String?
  updatedBy     String?
  registrations Registration[]
  notifications StudentNotification[]
  program       Program?              @relation(fields: [programId], references: [id])
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@map("students")
}

model Proctor {
  id                 String                @id @default(uuid())
  userId             String                @unique
  department         String?
  maxExamsPerDay     Int?                  @default(2)
  createdBy          String?
  updatedBy          String?
  assignments        ExamAssignment[]
  availableTimeSlots ProctorAvailability[]
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("proctors")
}

model Program {
  id           String      @id @default(uuid())
  name         String
  code         String      @unique
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime    @default(now())
  departmentId String?
  description  String?
  isActive     Boolean     @default(true)
  updatedAt    DateTime    @updatedAt
  courses      Course[]
  department   Department? @relation(fields: [departmentId], references: [id])
  students     Student[]

  @@map("programs")
}

model Department {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())
  programs  Program[]

  @@map("departments")
}

model Semester {
  id              String           @id @default(uuid())
  name            String
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean          @default(false)
  createdBy       String?
  updatedBy       String?
  academicYear    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  courseOfferings CourseOffering[]
  courses         Course[]

  @@map("semesters")
}

model Course {
  id              String           @id @default(uuid())
  code            String           @unique
  title           String           @unique
  programId       String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime         @default(now())
  credits         Int?
  description     String?
  isActive        Boolean          @default(true)
  updatedAt       DateTime         @updatedAt
  semesterId      String?
  courseOfferings CourseOffering[]
  program         Program?         @relation(fields: [programId], references: [id])
  semester        Semester?        @relation(fields: [semesterId], references: [id])

  @@index([programId])
  @@index([semesterId])
  @@map("courses")
}

model CourseOffering {
  id               String         @id @default(uuid())
  courseId         String
  semesterId       String
  section          String?
  expectedStudents Int            @default(0)
  capacity         Int?
  credits          Int?
  status           OfferingStatus @default(ACTIVE)
  createdBy        String?
  createdAt        DateTime       @default(now())
  day              String?
  instructor       String?
  notes            String?
  roomLabel        String?
  time             String?
  updatedAt        DateTime       @updatedAt
  difficulty       Int?
  priority         Int?
  courseType       CourseType     @default(COURSE)
  hasExam          Boolean        @default(true)
  endTime          String?
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester         Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  exams            Exam[]
  registrations    Registration[]

  @@unique([courseId, semesterId, section])
  @@index([courseId])
  @@index([semesterId])
  @@map("course_offerings")
}

model Registration {
  id               String         @id @default(uuid())
  studentId        String
  courseOfferingId String
  createdAt        DateTime       @default(now())
  status           String?        @default("ACTIVE")
  updatedAt        DateTime       @updatedAt
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseOfferingId])
  @@index([studentId])
  @@index([courseOfferingId])
  @@map("registrations")
}

model Center {
  id          String   @id @default(uuid())
  name        String   @unique
  location    String?
  createdBy   String?
  updatedBy   String?
  code        String?  @unique
  createdAt   DateTime @default(now())
  description String?
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
  supervisors String[] @default([])
  rooms       Room[]

  @@map("centers")
}

model Room {
  id          String           @id @default(uuid())
  centerId    String
  name        String           @unique
  capacity    Int
  status      RoomStatus       @default(AVAILABLE)
  createdBy   String?
  updatedBy   String?
  assignments ExamAssignment[]
  center      Center           @relation(fields: [centerId], references: [id], onDelete: Cascade)

  @@map("rooms")
}

model TimeSlot {
  id                String                @id @default(uuid())
  startTime         DateTime
  endTime           DateTime
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime              @default(now())
  date              DateTime?
  duration          Int?
  updatedAt         DateTime              @updatedAt
  assignments       ExamAssignment[]
  availableProctors ProctorAvailability[]

  @@unique([startTime, endTime])
  @@index([date])
  @@map("time_slots")
}

model ProctorAvailability {
  proctorId  String
  timeSlotId String
  proctor    Proctor  @relation(fields: [proctorId], references: [id], onDelete: Cascade)
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@id([proctorId, timeSlotId])
  @@index([timeSlotId])
  @@map("proctor_availabilities")
}

model Exam {
  id               String           @id @default(uuid())
  courseOfferingId String
  status           ExamStatus       @default(DRAFT)
  duration         Int?
  createdBy        String?
  assignments      ExamAssignment[]
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@index([courseOfferingId])
  @@map("exams")
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Schedule {
  id                   String                  @id @default(uuid())
  name                 String
  isFinal              Boolean                 @default(false)
  createdBy            String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  algorithmMetadata    Json?
  algorithmType        SchedulingAlgorithmType @default(HYBRID_CONSTRAINT_BASED)
  generationStage      ScheduleGenerationStage @default(GENERATED)
  hardConstraintScore  Int                     @default(0)
  qualityScore         Float?
  softConstraintScore  Int                     @default(0)
  examPeriod           String?
  publishedVersion     Int                     @default(0)
  lastPublishedAt      DateTime?
  assignments          ExamAssignment[]
  studentNotifications StudentNotification[]

  @@index([isFinal])
  @@index([isFinal, createdAt])
  @@map("schedules")
}

model StudentNotification {
  id         String    @id
  studentId  String
  scheduleId String?
  type       String
  title      String
  message    String
  metadata   Json?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, scheduleId, type])
  @@index([studentId, createdAt])
  @@index([scheduleId])
  @@map("student_notifications")
}

model Notification {
  id              String          @id
  userId          String
  type            String
  title           String
  message         String
  metadata        Json?
  readAt          DateTime?
  createdAt       DateTime        @default(now())
  scheduleId      String?
  scheduleVersion Int?
  assignmentId    String?
  assignment      ExamAssignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, scheduleId, scheduleVersion])
  @@unique([userId, type, scheduleId, assignmentId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([scheduleId])
  @@index([assignmentId])
  @@map("notifications")
}

model ExamAssignment {
  id            String         @id @default(uuid())
  scheduleId    String
  examId        String
  roomId        String
  proctorId     String
  timeSlotId    String
  exam          Exam           @relation(fields: [examId], references: [id], onDelete: Cascade)
  proctor       Proctor        @relation(fields: [proctorId], references: [id])
  room          Room           @relation(fields: [roomId], references: [id])
  schedule      Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  timeSlot      TimeSlot       @relation(fields: [timeSlotId], references: [id])
  notifications Notification[]

  @@unique([scheduleId, examId, roomId, proctorId, timeSlotId])
  @@index([scheduleId])
  @@index([examId])
  @@index([roomId])
  @@index([timeSlotId])
  @@index([proctorId])
  @@map("exam_assignments")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())
}





// Mini SIS → (Students, Courses, Enrollments)
//         ↓
// Scheduling → (Exams, TimeSlots, Rooms, Proctors)
//         ↓
// Execution → (Schedule, Assignments)


