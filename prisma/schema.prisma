generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------
// ENUMS
// -----------------------------------
enum Role {
  ADMIN
  PROCTOR
  STUDENT
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
}

enum OfferingStatus {
  ACTIVE
  INACTIVE
  CANCELLED
}

enum CourseType {
  COURSE
  PROJECT
}


enum SchedulingAlgorithmType {
  HYBRID_CONSTRAINT_BASED
}

enum ScheduleGenerationStage {
  PREPARED
  VALIDATED
  DRAFT_BUILT
  EVALUATED
  OPTIMIZED
  RE_EVALUATED
  CONFIRMED
  GENERATED
  BLOCKED
}

// -----------------------------------
// USER SYSTEM
// -----------------------------------
model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student    Student?
  proctor    Proctor?
  notifications Notification[]
  settings UserSettings?

  @@map("users")
}

model UserSettings {
  id String @id @default(uuid())
  userId String @unique
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedulePublishedNotifications Boolean @default(true)
  examAssignmentUpdates Boolean @default(true)
  roomTimeChanges Boolean @default(true)
  announcementsMessages Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_settings")
}

model Student {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  programId    String?
  program      Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  universityId String   @unique


  registrations Registration[]
  notifications StudentNotification[]
  
  @@index([programId])
  @@map("students")
  createdBy   String?
  updatedBy   String?
}

model Proctor {
  id             String  @id @default(uuid())
  userId         String  @unique
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  centerId       String
  center         Center  @relation(fields: [centerId], references: [id], onDelete: Restrict)
  department     String?
  maxExamsPerDay Int?    @default(2)

  assignments         ExamAssignment[]
  availableTimeSlots  ProctorAvailability[]

  @@map("proctors")
  createdBy   String?
  updatedBy   String?
}

// -----------------------------------
// MINI SIS (ACADEMIC DATA)
// -----------------------------------
model Program {
  id   String @id @default(uuid())
  name String
  code String @unique
  description  String?
  isActive     Boolean     @default(true)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  students Student[]
  courses  Course[]

  @@map("programs")
  createdBy   String?
  updatedBy   String?
}

model Department {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  createdAt DateTime  @default(now())

  programs  Program[]

  @@map("departments")
}


model Semester {
  id           String   @id @default(uuid())
  name         String   // e.g., "Fall 2026"
  startDate    DateTime
  endDate      DateTime
  academicYear String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  courseOfferings CourseOffering[]
  courses         Course[]

  @@map("semesters")
}

model Course {
  id        String   @id @default(uuid())
  code      String
  title     String
  programId String?
  program   Program? @relation(fields: [programId], references: [id], onDelete: SetNull)
  semesterId String?
  semester   Semester? @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  credits      Int?
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  courseOfferings CourseOffering[]
  
  @@unique([code, semesterId])
  @@index([programId])
  @@index([semesterId])
  @@map("courses")
  createdBy   String?
  updatedBy   String?
}

model CourseOffering {
  id               String         @id @default(uuid())
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId       String
  semester         Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  section          String?
  instructor   String?
  expectedStudents Int            @default(0)
  capacity         Int?
  day          String?
  time         String?
  roomLabel    String?
  notes        String?
  priority   Int?   // higher = schedule earlier
  difficulty Int?   // harder exam (needs spacing)
  courseType       CourseType      @default(COURSE)
  hasExam          Boolean         @default(true)
  status           OfferingStatus @default(ACTIVE)
  createdBy        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  registrations Registration[]
  exams         Exam[]

  // A specific course section should only occur once per semester
  @@unique([courseId, semesterId, section])
  @@index([courseId])
  @@index([semesterId])
  @@map("course_offerings")
}

model Registration {
  id               String         @id @default(uuid())
  studentId        String
  student          Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  status       String?        @default("ACTIVE")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt


  // Prevent duplicate enrollment for the exact same offering
  @@unique([studentId, courseOfferingId])
  @@index([studentId])
  @@index([courseOfferingId])
  @@map("registrations")
}

// -----------------------------------
// RESOURCES
// -----------------------------------
model Center {
  id       String  @id @default(uuid())
  name     String  @unique
  location String?
  code         String?        @unique
  description  String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt


  rooms        Room[]
  proctors     Proctor[]
  supervisors  String[] @default([])

  @@map("centers")
  createdBy   String?
  updatedBy   String?
}

model Room {
  id       String     @id @default(uuid())
  centerId String
  center   Center     @relation(fields: [centerId], references: [id], onDelete: Cascade)
  name     String
  capacity Int
  status   RoomStatus @default(AVAILABLE)

  assignments ExamAssignment[]

  // Room names must be unique within a center
  @@unique([centerId, name])
  @@map("rooms")
  createdBy   String?
  updatedBy   String?
}

model TimeSlot {
  id        String   @id @default(uuid())
  startTime DateTime
  endTime   DateTime
  date         DateTime?
  duration     Int?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  assignments         ExamAssignment[]
  availableProctors   ProctorAvailability[]

  @@unique([startTime, endTime])
  @@index([date])
  @@map("time_slots")
  createdBy   String?
  updatedBy   String?
}

model ProctorAvailability {
  proctorId  String
  timeSlotId String
  proctor    Proctor  @relation(fields: [proctorId], references: [id], onDelete: Cascade)
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@id([proctorId, timeSlotId])
  @@index([timeSlotId])
  @@map("proctor_availabilities")
}

// -----------------------------------
// EXAMS
// -----------------------------------
model Exam {
  id               String         @id @default(uuid())
  courseOfferingId String
  courseOffering   CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  status           ExamStatus     @default(DRAFT)
  duration         Int? // Duration in minutes
  createdBy        String?

  assignments ExamAssignment[]

  @@index([courseOfferingId])
  @@map("exams")
}

// -----------------------------------
// SCHEDULING CORE
// -----------------------------------
model Schedule {
  id        String   @id @default(uuid())
  name      String
  examPeriod String?
  isFinal   Boolean  @default(false)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  algorithmType       SchedulingAlgorithmType @default(HYBRID_CONSTRAINT_BASED)
  generationStage     ScheduleGenerationStage @default(GENERATED)
  qualityScore        Float?
  hardConstraintScore Int                     @default(0)
  softConstraintScore Int                     @default(0)
  algorithmMetadata   Json?

  assignments ExamAssignment[]
  studentNotifications StudentNotification[]

  @@map("schedules")
}

model StudentNotification {
  id         String    @id
  studentId  String
  student    Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  scheduleId String?
  schedule   Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  type       String
  title      String
  message    String
  metadata   Json?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([studentId, scheduleId, type])
  @@index([studentId, createdAt])
  @@index([scheduleId])
  @@map("student_notifications")
}

model Notification {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  metadata  Json?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model ExamAssignment {
  id         String   @id @default(uuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  examId String
  exam   Exam   @relation(fields: [examId], references: [id], onDelete: Cascade)

  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  proctorId String
  proctor   Proctor @relation(fields: [proctorId], references: [id], onDelete: Restrict)

  timeSlotId String
  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)

  // Prevents algorithm from generating duplicate identical assignments for the same schedule
  @@unique([scheduleId, examId, roomId, proctorId, timeSlotId])
  @@index([scheduleId])
  @@index([examId])
  @@index([roomId])
  @@index([timeSlotId])
  @@index([proctorId])
  @@map("exam_assignments")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  action      String
  entity      String
  entityId    String
  oldData     Json?
  newData     Json?
  createdAt   DateTime @default(now())
}



// Mini SIS → (Students, Courses, Enrollments)
//         ↓
// Scheduling → (Exams, TimeSlots, Rooms, Proctors)
//         ↓
// Execution → (Schedule, Assignments)

